# Copy this file to `.env` in the same folder (pipeline/.env) and fill in the values.
# `.env` is git-ignored — never commit it. `.env.example` (this file) has no secrets.

# Foursquare Places Portal → your access token (https://places.foursquare.com/)
FSQ_TOKEN=

# From the Places Portal's DuckDB or PyIceberg connection snippet (non-secret parts):
# the Iceberg REST catalog URL, and the warehouse / namespace if the snippet names them.
FSQ_CATALOG_URI=
FSQ_WAREHOUSE=
FSQ_NAMESPACE=

# Anthropic API key for 4b (build-time neighborhood identities, ~$1–2 for Manhattan).
# Can be the same key the Vercel backend uses, or a new one from console.anthropic.com.
ANTHROPIC_API_KEY=

# Last.fm read-only API key (tags / similar tracks). Optional — defaults to the app's
# public read key if unset.
LASTFM_API_KEY=

# Spotify app (developer.spotify.com/dashboard → your Flâneur app → Settings) for 4d.
# Client ID is the same one the iOS app uses; the secret never goes into the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music API (4d, Apple side). developer.apple.com → Certificates, Identifiers &
# Profiles → Keys → a key with "Media Services (MusicKit…)". Put the downloaded .p8 in
# pipeline/data/ (gitignored) and point to it.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=data/AuthKey_XXXXXXXXXX.p8

# Spotify requests per run (dev-mode quota is small; a run stops cleanly at this budget).
SPOTIFY_MAX_REQUESTS=400
